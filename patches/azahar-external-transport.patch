--- a/src/network/room_member.cpp
+++ b/src/network/room_member.cpp
@@ -42,6 +42,9 @@ public:
 
     MacAddress mac_address; ///< The mac_address of this member.
 
+    std::mutex external_mutex;                   ///< Guards external_send (TFH PC).
+    RoomMember::ExternalSendFn external_send;    ///< Set while using an external transport.
+
     std::mutex network_mutex; ///< Mutex that controls access to the `client` variable.
     /// Thread that receives and dispatches network packets
     std::unique_ptr<std::thread> loop_thread;
@@ -587,6 +590,15 @@ bool RoomMember::IsConnected() const {
 }
 
 void RoomMember::SendWifiPacket(const WifiPacket& wifi_packet) {
+    ExternalSendFn external_send;
+    {
+        std::lock_guard lock(room_member_impl->external_mutex);
+        external_send = room_member_impl->external_send;
+    }
+    if (external_send) { // called outside the lock: the transport may take its own locks
+        external_send(wifi_packet);
+        return;
+    }
     Packet packet;
     packet << static_cast<u8>(IdWifiPacket);
     packet << static_cast<u8>(wifi_packet.type);
@@ -678,7 +690,45 @@ void RoomMember::Unbind(CallbackHandle<T> handle) {
     room_member_impl->callbacks.Get<T>().erase(handle);
 }
 
+void RoomMember::ConnectExternal(const std::string& nick, const MacAddress& mac,
+                                 ExternalSendFn send) {
+    if (room_member_impl->loop_thread) {
+        Leave();
+    }
+    {
+        std::lock_guard lock(room_member_impl->external_mutex);
+        room_member_impl->external_send = std::move(send);
+    }
+    room_member_impl->nickname = nick;
+    room_member_impl->mac_address = mac;
+    room_member_impl->SetState(State::Joined);
+}
+
+void RoomMember::DisconnectExternal() {
+    {
+        std::lock_guard lock(room_member_impl->external_mutex);
+        if (!room_member_impl->external_send) {
+            return;
+        }
+        room_member_impl->external_send = nullptr;
+    }
+    room_member_impl->SetState(State::Idle);
+}
+
+bool RoomMember::IsExternal() const {
+    std::lock_guard lock(room_member_impl->external_mutex);
+    return static_cast<bool>(room_member_impl->external_send);
+}
+
+void RoomMember::InjectWifiPacket(const WifiPacket& packet) {
+    room_member_impl->Invoke<WifiPacket>(packet);
+}
+
 void RoomMember::Leave() {
+    if (!room_member_impl->loop_thread) {
+        DisconnectExternal();
+        return;
+    }
     room_member_impl->SetState(State::Idle);
     room_member_impl->loop_thread->join();
     room_member_impl->loop_thread.reset();
