     void Leave();
 
+    // --- Tri Force Heroes PC: external transport (e.g. Steam) -------------------
+    // Lets a frontend carry UDS wifi packets over its own network layer instead of
+    // an ENet room. While connected externally the member reports State::Joined,
+    // SendWifiPacket() goes to `send`, and InjectWifiPacket() delivers received
+    // packets to everything bound via BindOnWifiPacketReceived().
+    using ExternalSendFn = std::function<void(const WifiPacket&)>;
+    void ConnectExternal(const std::string& nick, const MacAddress& mac, ExternalSendFn send);
+    void DisconnectExternal();
+    bool IsExternal() const;
+    void InjectWifiPacket(const WifiPacket& packet);
+
 private:
     class RoomMemberImpl;
     std::unique_ptr<RoomMemberImpl> room_member_impl;
