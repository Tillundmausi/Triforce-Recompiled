+namespace {
+std::atomic<RomFSReadHook> g_romfs_read_hook{nullptr};
+} // namespace
+
+void SetRomFSReadHook(RomFSReadHook hook) {
+    g_romfs_read_hook.store(hook, std::memory_order_release);
+}
+
 ResultVal<std::size_t> IVFCFile::Read(const u64 offset, const std::size_t length,
                                       u8* buffer) const {
     LOG_TRACE(Service_FS, "called offset={}, length={}", offset, length);
+    if (const auto hook = g_romfs_read_hook.load(std::memory_order_acquire)) {
+        hook(romfs_file.get(), offset, length);
+    }
     return romfs_file->ReadFile(offset, length, buffer);
 }
 
